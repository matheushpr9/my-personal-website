# Copie para .env e preencha os valores

# Usuário admin do painel
ADMIN_USERNAME=admin
# Pode ser texto puro (só para setup inicial) ou hash bcrypt ($2a$...)
ADMIN_PASSWORD=minha-senha-aqui

# Chave secreta para assinar os JWT tokens (use algo longo e aleatório)
JWT_SECRET=troque-por-uma-chave-secreta-longa

# Caminho para o banco SQLite
DB_PATH=data.db

# Porta do servidor (padrão 3000)
PORT=3000
